+  .settings-v2-dialog [data-component="select-v2"],
+  .settings-v2-dialog [data-slot="text-input-v2-input"],
+  .settings-v2-dialog [data-component="button-v2"] { min-height: 48px; font-size: 16px; }
+  .settings-v2-dialog [data-component="select-v2"] {
+    width: 100%;
+    justify-content: space-between;
+    border: 1px solid var(--v2-border-border-base);
+    border-radius: 8px;
+    padding-inline: 12px;
+  }
+  .settings-v2-dialog [data-slot="select-v2-value-text"] { font-size: 16px; line-height: 24px; }
+  .settings-v2-dialog .settings-v2-provider-row { gap: 12px; }
+  .settings-v2-dialog .settings-v2-provider-lead { flex-basis: 100%; }
+  .settings-v2-dialog .settings-v2-provider-row > [data-component="button-v2"] { width: 100%; }
