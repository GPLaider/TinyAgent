+import { expect, test } from "@playwright/test"
+import { fixture, pageMessages } from "../performance/timeline/session-timeline-stress.fixture"
+import { installStressSessionTabs, installTimelineSettings } from "../performance/timeline/timeline-test-helpers"
+import { mockOpenCodeServer } from "../utils/mock-server"
+
+test.use({ viewport: { width: 390, height: 844 }, hasTouch: true })
+
+test("swipe reveals pin and delete without opening the session", async ({ page }) => {
+  await mockOpenCodeServer(page, { ...fixture, pageMessages })
+  await installTimelineSettings(page)
+  await installStressSessionTabs(page, { sessionIDs: [] })
+  await page.goto("/")
+  await page.getByRole("button", { name: "Dismiss Tabs information" }).click()
+  const row = page.locator('[data-component="home-session-row"]').filter({ hasText: fixture.expected.targetTitle })
+  await expect(row).toBeVisible()
+  const box = (await row.boundingBox())!
+  const touch = await page.context().newCDPSession(page)
+  const x = box.x + box.width - 70
+  const y = box.y + box.height / 2
+  await touch.send("Input.dispatchTouchEvent", { type: "touchStart", touchPoints: [{ x, y }] })
+  for (const distance of [15, 40, 80, 140]) {
+    await touch.send("Input.dispatchTouchEvent", { type: "touchMove", touchPoints: [{ x: x - distance, y }] })
+  }
+  await touch.send("Input.dispatchTouchEvent", { type: "touchEnd", touchPoints: [] })
+  const item = page.locator(".home-session-item").filter({ hasText: fixture.expected.targetTitle })
+  await expect(item.getByRole("button", { name: "Pin", exact: true })).toBeVisible()
+  await expect(item.getByRole("button", { name: "Delete", exact: true })).toBeVisible()
+  await expect(page).toHaveURL("/")
+  await item.getByRole("button", { name: "Pin", exact: true }).click()
+  await expect(page.getByText("Pinned", { exact: true })).toBeVisible()
+  await page.reload()
+  await expect(page.getByText("Pinned", { exact: true })).toBeVisible()
+  await expect(page.locator('[data-component="home-session-row"]').first()).toContainText(fixture.expected.targetTitle)
+  await item.getByRole("button", { name: "More options", exact: true }).click()
+  await item.getByRole("button", { name: "Delete", exact: true }).click()
+  await expect(page.getByRole("dialog")).toHaveCount(0)
+  await expect(row).toHaveCount(0)
+  await page.getByRole("button", { name: "Undo", exact: true }).click()
+  await expect(row).toBeVisible()
+  await item.getByRole("button", { name: "More options", exact: true }).click()
+  const removed = page.waitForRequest((request) => request.method() === "DELETE" && request.url().includes("ses_smoke_target"))
+  await item.getByRole("button", { name: "Delete", exact: true }).click()
+  await removed
+  await expect(row).toHaveCount(0)
+  await expect(page.getByRole("dialog")).toHaveCount(0)
+  await expect(page.getByRole("button", { name: "Undo", exact: true })).toHaveCount(0)
+})
+
+test("long press selects multiple sessions and bulk deletion can be undone", async ({ page }) => {
+  const errors: string[] = []
+  page.on("pageerror", (error) => errors.push(error.message))
+  const deleted: string[] = []
+  page.on("request", (request) => { if (request.method() === "DELETE") deleted.push(request.url()) })
+  await mockOpenCodeServer(page, { ...fixture, pageMessages })
+  await installTimelineSettings(page)
+  await installStressSessionTabs(page, { sessionIDs: [] })
+  await page.goto("/")
+  await page.getByRole("button", { name: "Dismiss Tabs information" }).click()
+  const rows = page.locator('[data-component="home-session-row"]')
+  const target = rows.filter({ hasText: fixture.expected.targetTitle })
+  const source = rows.filter({ hasText: fixture.sessions.find((item) => item.id === fixture.sourceID)!.title })
+  await expect(target).toBeVisible()
+  const box = (await target.boundingBox())!
+  const touch = await page.context().newCDPSession(page)
+  await touch.send("Input.dispatchTouchEvent", { type: "touchStart", touchPoints: [{ x: box.x + 90, y: box.y + box.height / 2 }] })
+  await expect(page.getByText("1 selected", { exact: true })).toBeVisible()
+  await touch.send("Input.dispatchTouchEvent", { type: "touchEnd", touchPoints: [] })
+  await expect(target).toHaveAttribute("aria-pressed", "true")
+  await source.tap()
+  await expect(page.getByText("2 selected", { exact: true })).toBeVisible()
+  await page.screenshot({ path: "e2e/test-results/session-multiselect.png" })
+  await page.getByRole("toolbar", { name: "Selection" }).getByRole("button", { name: "Delete", exact: true }).click()
+  await expect(page.getByRole("dialog")).toContainText("Delete 2 selected items?")
+  await page.getByRole("dialog").getByRole("button", { name: "Cancel", exact: true }).click()
+  await expect(target).toBeVisible()
+  await page.getByRole("toolbar", { name: "Selection" }).getByRole("button", { name: "Delete", exact: true }).click()
+  await page.getByRole("dialog").getByRole("button", { name: "Delete", exact: true }).click()
+  await expect(target).toHaveCount(0)
+  await expect(source).toHaveCount(0)
+  await page.screenshot({ path: "e2e/test-results/session-undo.png" })
+  await page.getByRole("button", { name: "Undo", exact: true }).click()
+  await expect(target).toBeVisible()
+  await expect(source).toBeVisible()
+  expect(deleted).toEqual([])
+  expect(errors).toEqual([])
+  await target.focus()
+  await page.keyboard.press("Shift+Space")
+  await source.tap()
+  await page.getByRole("toolbar", { name: "Selection" }).getByRole("button", { name: "Delete", exact: true }).click()
+  const committed = Promise.all([fixture.targetID, fixture.sourceID].map((id) =>
+    page.waitForRequest((request) => request.method() === "DELETE" && request.url().includes(id))))
+  await page.getByRole("dialog").getByRole("button", { name: "Delete", exact: true }).click()
+  await committed
+  await expect(target).toHaveCount(0)
+  await expect(source).toHaveCount(0)
+})
+
+test("project swipe removal offers undo without a confirmation dialog", async ({ page }) => {
+  await mockOpenCodeServer(page, { ...fixture, pageMessages })
+  await installTimelineSettings(page)
+  await installStressSessionTabs(page, { sessionIDs: [] })
+  await page.goto("/")
+  await page.getByRole("button", { name: "Dismiss Tabs information" }).click()
+  await page.locator(".home-project-picker > summary").click()
+  const row = page.locator('[data-component="home-project-row"]')
+  await expect(row).toHaveCount(1)
+  await expect(row).toBeVisible()
+  const box = (await row.boundingBox())!
+  const touch = await page.context().newCDPSession(page)
+  const x = box.x + 100, y = box.y + box.height / 2
+  await touch.send("Input.dispatchTouchEvent", { type: "touchStart", touchPoints: [{ x, y }] })
+  await touch.send("Input.dispatchTouchEvent", { type: "touchMove", touchPoints: [{ x: x - 65, y }] })
+  await touch.send("Input.dispatchTouchEvent", { type: "touchEnd", touchPoints: [] })
+  await page.locator(".home-project-item").getByRole("button", { name: "Delete", exact: true }).click()
+  await expect(row).toHaveCount(0)
+  await expect(page.getByRole("dialog")).toHaveCount(0)
+  await page.getByRole("button", { name: "Undo", exact: true }).click()
+  await expect(row).toBeVisible()
+  const restored = (await row.boundingBox())!
+  await touch.send("Input.dispatchTouchEvent", { type: "touchStart", touchPoints: [{ x: restored.x + 80, y: restored.y + restored.height / 2 }] })
+  await expect(page.getByText("1 selected", { exact: true })).toBeVisible()
+  await touch.send("Input.dispatchTouchEvent", { type: "touchEnd", touchPoints: [] })
+  await expect(row).toHaveAttribute("aria-pressed", "true")
+  await page.getByRole("toolbar", { name: "Selection" }).getByRole("button", { name: "Delete", exact: true }).click()
+  await page.getByRole("dialog").getByRole("button", { name: "Delete", exact: true }).click()
+  await expect(page.getByRole("button", { name: "Undo", exact: true })).toHaveCount(0)
+  await expect(row).toHaveCount(0)
+  // The stress init script deliberately re-seeds projects on every reload.
+  // Check the persisted close flag before that fixture overwrites it.
+  await expect.poll(() => page.evaluate(() => JSON.parse(localStorage.getItem("opencode.global.dat:server")!).projects.local)).toEqual([])
+})
+
+test("failed deletion restores the session instead of losing it", async ({ page }) => {
+  await mockOpenCodeServer(page, { ...fixture, pageMessages })
+  await page.route("**/session/" + fixture.targetID + "**", async (route) => {
+    if (route.request().method() !== "DELETE") return route.fallback()
+    await route.fulfill({ status: 500, contentType: "application/json", body: JSON.stringify({ message: "Test deletion rejected" }) })
+  })
+  await installTimelineSettings(page)
+  await installStressSessionTabs(page, { sessionIDs: [] })
+  await page.goto("/")
+  await page.getByRole("button", { name: "Dismiss Tabs information" }).click()
+  const item = page.locator(".home-session-item").filter({ hasText: fixture.expected.targetTitle })
+  await item.getByRole("button", { name: "More options", exact: true }).click()
+  await item.getByRole("button", { name: "Delete", exact: true }).click()
+  await expect(item).toHaveCount(0)
+  await expect(item).toBeVisible()
+  await expect(page.getByText("Failed to delete session", { exact: true })).toBeVisible()
+})
