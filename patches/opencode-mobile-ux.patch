@@ -0,0 +1,15 @@
+import { expect, test } from "bun:test"
+import { accessMode, accessRules } from "./tinyagent-access"
+
+test("permission modes honor blanket ordering without escalating custom restrictions", () => {
+  const allow = { permission: "*", pattern: "*", action: "allow" } as const
+  const deny = { permission: "bash", pattern: "rm *", action: "deny" } as const
+  expect(accessMode([])).toBe("basic")
+  for (const mode of ["basic", "read", "yolo"] as const) expect(accessMode(accessRules(mode))).toBe(mode)
+  expect(accessMode([allow])).toBe("yolo")
+  expect(accessMode([deny, allow])).toBe("yolo")
+  expect(accessMode([allow, deny])).toBe("custom")
+  expect(accessMode([deny])).toBe("custom")
+  expect(accessMode([...accessRules("yolo"), { permission: "doom_loop", pattern: "*", action: "ask" }])).toBe("custom")
+  expect(accessMode([{ permission: "*", pattern: "*", action: "deny" }])).toBe("custom")
+})
diff --git a/packages/app/src/pages/session/composer/tinyagent-access.tsx b/packages/app/src/pages/session/composer/tinyagent-access.tsx
new file mode 100644
