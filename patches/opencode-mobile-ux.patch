-    return Equal.equals(a, b)
+    if (a === b) return true
+    if (a._tag !== b._tag || a.userMessageID !== b.userMessageID) return false
+    switch (a._tag) {
+      case "AssistantPart": {
+        if (b._tag !== "AssistantPart" || a.previousAssistantPart !== b.previousAssistantPart ||
+          a.group.key !== b.group.key || a.group.type !== b.group.type) return false
+        const left = a.group.type === "part" ? [a.group.ref] : a.group.refs
+        const right = b.group.type === "part" ? [b.group.ref] : b.group.refs
+        return left.length === right.length && left.every((ref, index) =>
+          ref.messageID === right[index]!.messageID && ref.partID === right[index]!.partID)
+      }
+      case "UserMessage":
+        return b._tag === "UserMessage" && a.anchor === b.anchor
+      case "TurnDivider":
+        return b._tag === "TurnDivider" && a.label === b.label
+      case "Thinking":
+        return b._tag === "Thinking" && a.reasoningHeading === b.reasoningHeading
+      case "Error":
+        return b._tag === "Error" && a.text === b.text
+      case "DiffSummary":
+        return b._tag === "DiffSummary" && Equal.equals(a.diffs, b.diffs)
+      case "TurnGap":
+      case "CommentStrip":
+      case "Retry":
+        return true
+    }
   }
 }
