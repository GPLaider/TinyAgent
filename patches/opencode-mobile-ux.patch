+import { expect, test } from "@playwright/test"
+import { fixture } from "../performance/timeline/session-timeline-stress.fixture"
+import { installTimelineSettings } from "../performance/timeline/timeline-test-helpers"
+import { mockOpenCodeServer } from "../utils/mock-server"
+import { base64Encode } from "@opencode-ai/core/util/encode"
+
+for (const restricted of [false, true]) test(`API-created permission displays ${restricted ? "custom restrictions" : "full access"}`, async ({ page }) => {
+  const changes: string[] = []
+  page.on("request", request => {
+    const path = new URL(request.url()).pathname
+    if ((request.method() === "PATCH" && path.startsWith("/session/")) || path.includes("/reply")) changes.push(request.url())
+  })
+  const permission = [
+    { permission: "*", pattern: "*", action: "allow" },
+    ...(restricted ? [{ permission: "bash", pattern: "rm *", action: "deny" }] : []),
+  ]
+  await mockOpenCodeServer(page, {
+    ...fixture,
+    sessions: [{ ...fixture.sessions.find(session => session.id === fixture.targetID)!, permission }],
+    pageMessages: () => ({ items: [] }),
+  })
+  await installTimelineSettings(page)
+  await page.goto(`/${base64Encode(fixture.directory)}/session/${fixture.targetID}`)
+  await expect(page.getByRole("combobox", { name: "에이전트 승인 모드" })).toHaveValue(restricted ? "custom" : "yolo")
+  expect(changes).toEqual([])
+})
+
+for (const [width, theme] of [[320, "light"], [390, "light"], [1280, "light"], [390, "dark"]] as const) {
+  test.describe(`compact access strip ${width}px ${theme}`, () => {
+    test.use({ viewport: { width, height: 844 }, hasTouch: width < 768, colorScheme: theme })
+
+    test("keeps permissions readable without a second composer box", async ({ page }, testInfo) => {
+      const errors: string[] = []
+      const changes: unknown[] = []
+      page.on("pageerror", error => errors.push(error.message))
+      page.on("console", message => {
+        // V1 mock protocol negotiation intentionally returns 404 for this V2 probe.
+        if (message.location().url.endsWith("/api/health") && message.text().includes("404")) return
+        if (message.type() === "error") errors.push(`${message.text()} ${message.location().url}`)
+      })
+      const session = { ...fixture.sessions.find(item => item.id === fixture.targetID)!, permission: [] as unknown[] }
+      await mockOpenCodeServer(page, { ...fixture, sessions: [session], pageMessages: () => ({ items: [] }) })
+      await page.route(new RegExp(`/session/${session.id}$`), async route => {
+        if (route.request().method() !== "PATCH") return route.fallback()
+        const body = route.request().postDataJSON()
+        changes.push(body)
+        session.permission = body.permission
+        await route.fulfill({ json: session })
+      })
+      await page.addInitScript((theme) => {
+        localStorage.setItem("opencode-color-scheme", theme)
+        localStorage.setItem("settings.v3", JSON.stringify({ general: { newLayoutDesigns: true, shouldDisplayTabsToast: false } }))
+      }, theme)
+      await page.goto(`/${base64Encode(fixture.directory)}/session/${session.id}`)
+      await expect(page).toHaveURL(new RegExp(`/session/${session.id}$`))
+      await expect(page).toHaveTitle(/OpenCode/)
+      await expect(page.locator("html")).toHaveAttribute("data-color-scheme", theme)
+      await expect(page.locator("vite-error-overlay")).toHaveCount(0)
+      const strip = page.locator('[data-component="tinyagent-access"]')
+      const select = strip.getByRole("combobox", { name: "에이전트 승인 모드" })
+      const input = page.locator('[data-component="prompt-input-v2"] [data-component="prompt-input"]')
+      await expect(select).toHaveValue("basic")
+      await expect(select).toBeEnabled()
+      expect(changes).toEqual([])
+      await expect(strip).toHaveCSS("border-top-width", "0px")
+      await expect(strip).toHaveCSS("background-color", "rgba(0, 0, 0, 0)")
+      await expect(strip).toHaveCSS("margin-bottom", "0px")
+      expect((await strip.boundingBox())!.height).toBeLessThanOrEqual(44)
+      const box = (await select.boundingBox())!
+      expect(box.height).toBeGreaterThanOrEqual(44)
+      expect(box.x + box.width).toBeLessThanOrEqual(width - 8)
+      await input.fill("Keep this draft")
+
+      const colors = new Set<string>()
+      for (const [index, mode] of ["read", "basic", "yolo"].entries()) {
+        await select.selectOption(mode)
+        await expect.poll(() => changes.length).toBe(index + 1)
+        await expect(select).toBeEnabled()
+        await expect(select).toHaveValue(mode)
+        await expect(input).toHaveText("Keep this draft")
+        const color = await select.evaluate(el => getComputedStyle(el).color)
+        colors.add(color)
+        await expect(select.locator(`option[value="${mode}"]`)).toHaveCSS("color", color)
+        await page.screenshot({ path: testInfo.outputPath(`access-${width}-${theme}-${mode}.png`), animations: "disabled" })
+      }
+      expect(colors.size).toBe(3)
+      await strip.locator("summary").click()
+      await expect(strip.locator("details")).toHaveAttribute("open", "")
+      await expect(strip.getByText("이 세션에 저장됩니다. Android의 Stock·Developer·Root 권한은 바뀌지 않습니다.")).toBeVisible()
+      await strip.locator("summary").click()
+      await expect(strip.locator("details")).not.toHaveAttribute("open", "")
+      expect(errors).toEqual([])
+    })
+  })
+}
diff --git a/packages/app/e2e/regression/session-reconnect.spec.ts b/packages/app/e2e/regression/session-reconnect.spec.ts
new file mode 100644
index 000000000..a2c8f4159
--- /dev/null
+++ b/packages/app/e2e/regression/session-reconnect.spec.ts
@@ -0,0 +1,34 @@
+import { expect, test } from "@playwright/test"
+import { fixture, pageMessages } from "../performance/timeline/session-timeline-stress.fixture"
+import { installStressSessionTabs, installTimelineSettings, stressSessionHref } from "../performance/timeline/timeline-test-helpers"
+import { mockOpenCodeServer } from "../utils/mock-server"
+
+test("reconnect recovers a final answer missed by the event stream without navigation", async ({ page }) => {
+  let completed = false
+  let connections = 0
+  const id = fixture.targetID
+  const final = "Recovered final answer after disconnected stream"
+  await mockOpenCodeServer(page, {
+    ...fixture,
+    sessionStatus: () => completed ? {} : { [id]: { type: "busy" } },
+    events: () => { connections++; return [] },
+    eventRetry: 250,
+    pageMessages: (sessionID, limit, before) => {
+      const result = pageMessages(sessionID, limit, before)
+      if (!completed || sessionID !== id) return result
+      const items = structuredClone(result.items)
+      const last = items.at(-1)!
+      last.parts = [{ id: "prt_recovered_final", sessionID: id, messageID: last.info.id, type: "text", text: final }]
+      return { ...result, items }
+    },
+  })
+  await installTimelineSettings(page)
+  await installStressSessionTabs(page)
+  await page.goto(stressSessionHref(id))
+  await expect(page.locator('[data-message-id]').last()).toBeVisible()
+  const before = connections
+  completed = true
+  await expect.poll(() => connections).toBeGreaterThan(before)
+  await expect(page.getByText(final, { exact: true })).toBeVisible()
+  await expect(page).toHaveURL(stressSessionHref(id))
+})
