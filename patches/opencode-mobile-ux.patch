+  .settings-v2[data-component="tabs-v2"][data-variant="settings"][data-orientation="vertical"] [data-slot="tabs-v2-list"] {
+    width: 100%;
+    min-width: 0;
+    padding: 16px 24px;
+    background: var(--v2-background-bg-base);
+    overflow-y: auto;
+  }
+  .settings-v2[data-mobile-detail="true"] [data-slot="tabs-v2-list"],
+  .settings-v2[data-mobile-detail="false"] .settings-v2-panel { display: none !important; }
+  .settings-v2 [data-slot="tabs-v2-section-title"] { display: none; }
