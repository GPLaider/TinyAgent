@@ -0,0 +1,125 @@
+import { createMemo, onCleanup, Show } from "solid-js"
+import { createStore } from "solid-js/store"
+import { Portal } from "solid-js/web"
+import { useDialog } from "@opencode-ai/ui/context/dialog"
+import { ButtonV2 } from "@opencode-ai/ui/v2/button-v2"
+import { useLanguage } from "@/context/language"
+import { errorMessage } from "@/pages/layout/helpers"
+import { showToast } from "@/utils/toast"
+
+export function createListActions<T>(options: { key: (item: T) => string; remove: (item: T) => Promise<void> }) {
+  const language = useLanguage()
+  const dialog = useDialog()
+  const [state, setState] = createStore({ selected: [] as T[], pending: [] as T[], removing: [] as T[] })
+  let timer: ReturnType<typeof setTimeout> | undefined
+  const contains = (items: T[], item: T) => items.some((entry) => options.key(entry) === options.key(item))
+  const undo = () => { clearTimeout(timer); setState("pending", []) }
+  // Leaving the list during the undo window cancels uncommitted deletion.
+  onCleanup(undo)
+  const queue = (items: T[]) => {
+    clearTimeout(timer)
+    setState("pending", (pending) => [...pending, ...items.filter((item) => !contains(pending, item))])
+    setState("selected", [])
+    timer = setTimeout(() => {
+      const pending = [...state.pending]
+      setState("removing", (items) => [...items, ...pending])
+      setState("pending", [])
+      void Promise.all(pending.map(async (item) => {
+        await options.remove(item).catch((cause) => showToast({
+          title: language.t("session.delete.failed.title"),
+          description: errorMessage(cause, language.t("common.requestFailed")),
+        }))
+        setState("removing", (items) => items.filter((entry) => options.key(entry) !== options.key(item)))
+      }))
+    }, 6000)
+  }
+  const confirm = async () => {
+    const selected = [...state.selected]
+    if (!selected.length) return
+    const { DialogV2, DialogHeader, DialogTitleGroup, DialogFooter } = await import("@opencode-ai/ui/v2/dialog-v2")
+    dialog.show(() => <DialogV2 fit>
+      <DialogHeader><DialogTitleGroup title={language.t("home.list.deleteSelected", { count: selected.length })}
+        description={language.t("home.list.deleteDescription")} /></DialogHeader>
+      <DialogFooter>
+        <ButtonV2 variant="ghost" onClick={() => dialog.close()}>{language.t("common.cancel")}</ButtonV2>
+        <ButtonV2 variant="danger" onClick={() => { queue(selected); dialog.close() }}>{language.t("common.delete")}</ButtonV2>
+      </DialogFooter>
+    </DialogV2>)
+  }
+  return {
+    count: () => state.selected.length,
+    pending: () => state.pending.length,
+    selected: (item: T) => contains(state.selected, item),
+    hidden: (item: T) => contains(state.pending, item) || contains(state.removing, item),
+    toggle: (item: T) => setState("selected", (items) => contains(items, item)
+      ? items.filter((entry) => options.key(entry) !== options.key(item)) : [...items, item]),
+    clear: () => setState("selected", []),
+    reset: () => { undo(); setState("selected", []) },
+    queue: (item: T) => queue([item]),
+    confirm,
+    undo,
+  }
+}
+
+export function ListActionBars(props: { actions: Pick<ReturnType<typeof createListActions>, "count" | "pending" | "clear" | "confirm" | "undo"> }) {
+  const language = useLanguage()
+  return <>
+    <Show when={props.actions.count()}>
+      <div class="home-selection-bar" role="toolbar" aria-label={language.t("home.list.selection")}>
+        <button type="button" onClick={props.actions.clear}>{language.t("common.cancel")}</button>
+        <strong aria-live="polite">{language.t("home.list.selected", { count: props.actions.count() })}</strong>
+        <button type="button" class="home-selection-delete" onClick={props.actions.confirm}>{language.t("common.delete")}</button>
+      </div>
+    </Show>
+    <Show when={props.actions.pending()}>
+      <Portal><div class="home-undo-bar" role="status">
+        <span>{language.t("home.list.removed", { count: props.actions.pending() })}</span>
+        <button type="button" onClick={props.actions.undo}>{language.t("home.list.undo")}</button>
+      </div></Portal>
+    </Show>
+  </>
+}
+
+export function createRowGesture(options: { hold: () => void; selecting: () => boolean; width: number }) {
+  const [state, setState] = createStore({ offset: 0, open: false, dragging: false, pressed: false })
+  const start = { x: 0, y: 0, active: false, moved: false }
+  let timer: ReturnType<typeof setTimeout> | undefined
+  const releaseClickGuard = () => {
+    document.removeEventListener("click", suppressClick, true)
+    document.removeEventListener("pointerdown", releaseClickGuard, true)
+  }
+  const suppressClick = (event: MouseEvent) => { event.preventDefault(); event.stopImmediatePropagation(); releaseClickGuard() }
+  const close = () => setState({ open: false, offset: 0, dragging: false, pressed: false })
+  const cancel = () => { clearTimeout(timer); start.active = false; setState({ dragging: false, pressed: false, offset: state.open ? -options.width : 0 }) }
+  onCleanup(() => { clearTimeout(timer); releaseClickGuard() })
+  return {
+    state, close,
+    reveal: () => setState({ open: true, offset: -options.width }),
+    style: createMemo(() => ({ transform: `translateX(${state.offset}px)`, transition: state.dragging ? "none" : undefined })),
+    down: (event: PointerEvent) => {
+      if (event.button !== 0) return
+      start.x = event.clientX; start.y = event.clientY; start.active = true; start.moved = false
+      setState("pressed", true)
+      timer = setTimeout(() => {
+        start.moved = true; start.active = false; close()
+        // Android can retarget touch-release click after the selection toolbar moves rows.
+        document.addEventListener("click", suppressClick, true)
+        document.addEventListener("pointerdown", releaseClickGuard, true)
+        options.hold()
+      }, 450)
+      ;(event.currentTarget as HTMLElement).setPointerCapture(event.pointerId)
+    },
+    move: (event: PointerEvent) => {
+      if (!start.active) return
+      const x = event.clientX - start.x
+      const y = event.clientY - start.y
+      if (Math.hypot(x, y) > 8) { clearTimeout(timer); setState("pressed", false); start.moved = true }
+      if (Math.abs(y) > 10 && Math.abs(y) > Math.abs(x)) { cancel(); return }
+      if (options.selecting() || Math.abs(x) < 8 || Math.abs(x) < Math.abs(y)) return
+      setState({ dragging: true, offset: Math.max(-options.width - 18, Math.min(0, (state.open ? -options.width : 0) + x)) })
+    },
+    up: () => { clearTimeout(timer); start.active = false; const open = state.offset < -40; setState({ open, dragging: false, pressed: false, offset: open ? -options.width : 0 }) },
+    cancel: () => { start.moved = true; cancel() },
+    consumed: () => { if (start.moved) { start.moved = false; return true }; if (state.open) { close(); return true }; return false },
+  }
+}
