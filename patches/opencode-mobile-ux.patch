+  .settings-mobile-header h1 { padding-inline: 8px; font-size: 24px; font-weight: 640; }
+  .settings-mobile-header button {
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    gap: 8px;
+    min-width: 48px;
+    min-height: 48px;
+    font-size: 16px;
+  }
+  .settings-v2[data-component="tabs-v2"][data-variant="settings"][data-orientation="vertical"] {
+    height: auto;
+    min-height: 0;
+    flex: 1;
