+  .provider-connect-dialog [data-slot="dialog-body"] { padding: 16px 8px; }
+  [data-component="dialog-v2"][data-variant="settings"] [data-slot="dialog-container"] {
+    width: 100%;
+    height: 100dvh;
+    max-height: 100%;
+    border-radius: 0;
+  }
+  .settings-mobile-header {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    flex: none;
+    width: 100%;
+    min-height: 64px;
+    padding: 8px 16px;
+    border-bottom: 1px solid var(--v2-border-border-base);
+  }
+  .settings-mobile-header h1 { padding-inline: 8px; font-size: 24px; font-weight: 640; }
+  .settings-mobile-header button {
