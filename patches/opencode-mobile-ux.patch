+
+async function expectPromptControlsToFit(composer: Locator, model: Locator, send: Locator) {
+  const geometry = await Promise.all([composer, model, send].map((locator) => locator.boundingBox()))
+  const [composerBox, modelBox, sendBox] = geometry
+  expect(composerBox).not.toBeNull()
+  expect(modelBox).not.toBeNull()
+  expect(sendBox).not.toBeNull()
+  expect(sendBox!.width).toBeGreaterThanOrEqual(28)
+  expect(sendBox!.x + sendBox!.width).toBeLessThanOrEqual(composerBox!.x + composerBox!.width)
+  expect(modelBox!.x + modelBox!.width).toBeLessThanOrEqual(sendBox!.x)
+  expect(await model.locator("span.truncate").evaluate((element) => element.scrollWidth > element.clientWidth)).toBe(
+    true,
+  )
+}
