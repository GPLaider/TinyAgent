+  .settings-v2-panel { min-width: 0; overscroll-behavior: contain; }
+  .settings-v2-dialog .settings-v2-tab-header { position: static; padding: 24px 24px 20px; background: none; }
+  .settings-v2-dialog .settings-v2-tab-title { font-size: 24px; line-height: 32px; }
+  .settings-v2-dialog .settings-v2-tab-body { padding: 0 24px 32px; gap: 32px; }
+  .settings-v2-dialog [data-component="settings-v2-list"] {
+    padding-inline: 0;
+    border-radius: 0;
+    background: none;
+    box-shadow: none;
+  }
+  .settings-v2-dialog [data-component="settings-v2-row"] { gap: 12px; padding-block: 20px; }
+  .settings-v2-dialog [data-slot="settings-v2-row-copy"] { flex-basis: 100%; gap: 6px; }
+  .settings-v2-dialog [data-slot="settings-v2-row-title"],
+  .settings-v2-dialog .settings-v2-provider-name,
+  .settings-v2-dialog .settings-v2-section-title { font-size: 16px; line-height: 24px; }
+  .settings-v2-dialog [data-slot="settings-v2-row-description"],
+  .settings-v2-dialog .settings-v2-provider-description { font-size: 14px; line-height: 22px; margin: 0; }
+  .settings-v2-dialog [data-slot="settings-v2-row-control"] { width: 100%; justify-content: stretch; }
+  .settings-v2-dialog [data-component="settings-v2-row"]:has([data-component="switch"]) {
+    flex-wrap: nowrap;
+    align-items: flex-start;
+  }
+  .settings-v2-dialog [data-component="settings-v2-row"]:has([data-component="switch"]) [data-slot="settings-v2-row-control"] {
+    width: auto;
+    flex: none;
+    min-width: 48px;
+    min-height: 48px;
+    align-items: center;
+  }
+  .settings-v2-dialog [data-component="select-v2-root"],
+  .settings-v2-dialog [data-slot="settings-v2-row-control"] > div { width: 100% !important; }
+  .settings-v2-dialog [data-component="select-v2"],
+  .settings-v2-dialog [data-slot="text-input-v2-input"],
+  .settings-v2-dialog [data-component="button-v2"] { min-height: 48px; font-size: 16px; }
+  .settings-v2-dialog [data-component="select-v2"] {
+    width: 100%;
+    justify-content: space-between;
+    border: 1px solid var(--v2-border-border-base);
+    border-radius: 8px;
+    padding-inline: 12px;
+  }
+  .settings-v2-dialog [data-slot="select-v2-value-text"] { font-size: 16px; line-height: 24px; }
+  .settings-v2-dialog .settings-v2-provider-row { gap: 12px; }
+  .settings-v2-dialog .settings-v2-provider-lead { flex-basis: 100%; }
+  .settings-v2-dialog .settings-v2-provider-row > [data-component="button-v2"] { width: 100%; }
+  .settings-v2-dialog .settings-v2-provider-empty { font-size: 14px; line-height: 22px; }
+  .settings-v2-dialog .settings-v2-models-group-trigger { min-height: 48px; }
+  .settings-v2-dialog .settings-v2-models [data-slot="settings-v2-row-title"] { white-space: normal; overflow-wrap: anywhere; }
+  .settings-v2-dialog button:focus-visible { outline: 2px solid var(--v2-border-border-focus); outline-offset: 2px; }
+}
