+import { createEffect, createSignal, onCleanup, Show } from "solid-js"
+import { useParams } from "@solidjs/router"
+import { useSDK } from "@/context/sdk"
+import { SessionPermissionDock } from "./session-permission-dock"
+import type { PermissionRequest } from "@opencode-ai/sdk/v2"
+
+type Mode = "basic" | "read" | "yolo"
+type Rule = { permission: string; pattern: string; action: "allow" | "ask" }
+export function accessRules(mode: Mode): Rule[] {
+  const rule = (permission: string, action: "allow" | "ask", pattern = "*"): Rule => ({ permission, pattern, action })
+  const rules = [rule("*", mode === "read" ? "ask" : "allow"), rule("external_directory", mode === "yolo" ? "allow" : "ask"), rule("doom_loop", mode === "yolo" ? "allow" : "ask")]
+  for (const name of ["read", "glob", "grep", "list"]) rules.push(rule(name, "allow"))
+  // The directory includes signing material; allow only known harness reads via
+  // one-time replies below, never grant broad /root access in the basic modes.
+  return rules
+}
+const safeReads = new Set(["AGENTS.md", "STOCK.md", "ADB.md", "ROOT.md", "TINYAGENT_ENVIRONMENT.md", "ANDROID_TOOL.md"].map(x => "/root/.tinyagent/" + x))
+for (const x of ["prepare-development.sh", "prepare-self-build.sh", "prepare-android-sdk-fedora.py", "configure-android-sdk-fedora.py"]) safeReads.add("/root/.tinyagent/bootstrap/" + x)
+safeReads.add("/etc/os-release")
+safeReads.add("/etc/fedora-release")
+
+export function TinyAgentAccess() {
+  const params = useParams()
+  const sdk = useSDK()
+  const [mode, setMode] = createSignal<Mode>("basic")
+  const [pending, setPending] = createSignal<PermissionRequest[]>([])
+  const [busy, setBusy] = createSignal(false)
+  const [error, setError] = createSignal("")
+  let policyVersion = 0
+  let refresh = async () => {}
+  async function request(path: string, method = "GET", body?: unknown) {
+    const response = await fetch(path, { method, headers: { "Content-Type": "application/json", "x-opencode-directory": sdk().directory }, body: body === undefined ? undefined : JSON.stringify(body) })
+    if (!response.ok) throw new Error(`권한 설정 요청 실패 (${response.status})`)
+    return response.json()
+  }
+  createEffect(() => {
+    const id = params.id
+    sdk().directory
+    setPending([])
+    if (!id) return
+    let disposed = false, loading = false
+    refresh = async () => {
+      if (loading || disposed) return
+      loading = true
+      const version = policyVersion
+      try {
+        const [session, requests] = await Promise.all([request(`/session/${id}`), request("/permission")])
+        if (disposed) return
+        const rules: Rule[] = session.permission ?? []
+        const wildcard = rules.filter(r => r.permission === "*" && r.pattern === "*").at(-1)
+        const external = rules.filter(r => r.permission === "external_directory").at(-1)
+        setMode(wildcard?.action === "ask" ? "read" : wildcard?.action === "allow" && external?.action === "allow" ? "yolo" : "basic")
+        const selected: PermissionRequest[] = requests.filter((r: PermissionRequest) => r.sessionID === id)
+        setPending(selected)
+        setError("")
+        // Reconcile initial events and reconnects using the backend's actual queue.
+        // Only verify bundled, read-only environment requests automatically.
+        for (const p of selected) {
+          if (disposed || busy() || version !== policyVersion) break
+          const path = p.metadata?.filepath
+          if (mode() === "yolo") {
+            await request(`/permission/${p.id}/reply`, "POST", { reply: "once" })
+          } else if (p.permission === "external_directory" && typeof path === "string" && safeReads.has(path)) {
+            const messages = await request(`/session/${id}/message`)
+            const read = messages.flatMap((m: { parts: any[] }) => m.parts).some((part: any) => part.tool === "read" && part.callID === p.tool?.callID && part.state?.input?.filePath === path)
+            if (!disposed && !busy() && version === policyVersion && read) await request(`/permission/${p.id}/reply`, "POST", { reply: "once" })
+          }
+        }
+      } catch (e) { if (!disposed) setError(e instanceof Error ? e.message : "권한 상태 확인 실패") }
+      finally { loading = false }
+    }
+    void refresh()
+    const timer = setInterval(() => void refresh(), 2000)
+    onCleanup(() => { disposed = true; clearInterval(timer) })
+  })
+  async function change(value: Mode) {
+    const id = params.id
+    if (!id || busy()) return
+    policyVersion++
+    setBusy(true)
+    try {
+      await request(`/session/${id}`, "PATCH", { permission: accessRules(value) })
+      await refresh()
+    } catch (e) { setError(e instanceof Error ? e.message : "권한 설정 실패") }
+    finally { setBusy(false) }
+  }
+  async function decide(reply: "once" | "always" | "reject") {
+    const p = pending()[0]
+    if (!p || busy()) return
+    setBusy(true)
+    try { await request(`/permission/${p.id}/reply`, "POST", { reply }); await refresh() }
+    catch (e) { setError(e instanceof Error ? e.message : "승인 응답 실패") }
+    finally { setBusy(false) }
+  }
+  return <Show when={params.id}>
+    <div data-component="tinyagent-access" class="rounded-lg border border-border-weak-base bg-background-base px-3 py-1 mb-2 text-text-base">
+      <div class="flex items-start justify-between gap-2">
+        <details class="min-w-0 flex-1 text-12-regular text-text-weak">
+          <summary class="min-h-11 flex items-center cursor-pointer text-14-medium text-text-base">에이전트 승인 ⓘ</summary>
+          <p class="pb-2">이 세션에 저장됩니다. Android의 Stock·Developer·Root 권한은 바뀌지 않습니다.</p>
+        </details>
+        <select aria-label="에이전트 승인 모드" value={mode()} disabled={busy()} onChange={e => void change(e.currentTarget.value as Mode)} class="min-h-11 rounded-md bg-background-stronger px-3 text-text-base">
+          <option value="basic">기본</option><option value="read">읽기 전용</option><option value="yolo">전체 허용 · YOLO</option>
+        </select>
+      </div>
+      <Show when={error()}><p role="alert" class="text-13-regular mt-2">{error()}</p></Show>
+      <Show when={pending()[0]} keyed>{p => <div class="mt-2" role="region" aria-label="승인 대기">
+        <p role="status" class="text-14-medium">승인 대기 · {pending().length}건 — 허용 또는 거부를 선택하세요.</p>
+        <SessionPermissionDock request={p} responding={busy()} onDecide={reply => void decide(reply)} />
+      </div>}</Show>
+    </div>
+  </Show>
+}
