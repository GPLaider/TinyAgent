+  .provider-connect-dialog form [data-row] { display: grid; grid-template-columns: minmax(0, 1fr) 48px; }
+  .provider-connect-dialog form [data-row] > div { grid-column: 1; min-width: 0; }
+  .provider-connect-dialog form [data-row] > button { grid-column: 2; grid-row: 1 / span 2; margin-top: 0; }
+  .provider-connect-dialog form { font-size: 16px; line-height: 24px; }
+  .provider-connect-dialog .custom-provider-form { max-height: none; min-height: 0; flex: 1; }
+  .provider-connect-dialog [data-slot="dialog-body"] { padding: 16px 8px; }
+  [data-component="dialog-v2"][data-variant="settings"] [data-slot="dialog-container"] {
+    width: 100%;
+    height: 100dvh;
+    max-height: 100%;
+    border-radius: 0;
+  }
+  .settings-mobile-header {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    flex: none;
+    width: 100%;
+    min-height: 64px;
+    padding: 8px 16px;
+    border-bottom: 1px solid var(--v2-border-border-base);
