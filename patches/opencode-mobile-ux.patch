+      const errors: string[] = []
+      page.on("pageerror", (error) => errors.push(error.message))
+      page.on("console", (message) => {
+        // The mock intentionally returns 404 for the V2 probe before selecting the V1 protocol.
+        if (message.location().url.endsWith("/api/health") && message.text().includes("404")) return
+        if (message.type() === "error") errors.push(`${message.text()} ${message.location().url}`)
+      })
+      await mockOpenCodeServer(page, {
+        directory,
+        project: {
+          id: projectID,
+          worktree: directory,
+          vcs: "git",
+          name: "prompt-long-model-mobile",
+          time: { created: 1_700_000_000_000, updated: 1_700_000_000_000 },
+          sandboxes: [],
+        },
+        provider: {
+          all: [
+            {
+              id: "openai",
+              name: "OpenAI",
+              models: {
+                "long-model": {
+                  id: "long-model",
+                  name: modelName,
+                  cost: { input: 1, output: 1 },
+                  limit: { context: 200_000 },
+                  variants: { high: {}, xhigh: {} },
+                },
+                "compact-model": {
+                  id: "compact-model",
+                  name: "Compact Model",
+                  cost: { input: 1, output: 1 },
+                  limit: { context: 200_000 },
+                  variants: { high: {}, xhigh: {} },
+                },
+                ...Object.fromEntries(
+                  Array.from({ length: 28 }, (_, i) => [
+                    "extra-model-" + i,
+                    {
+                      id: "extra-model-" + i,
+                      name: "Test Model " + String(i).padStart(2, "0") + " Extended Context Preview",
+                      cost: { input: 1, output: 1 },
+                      limit: { context: 200_000 },
+                    },
+                  ]),
+                ),
+              },
+            },
+          ],
+          connected: ["openai"],
+          default: { providerID: "openai", modelID: "long-model" },
+        },
+        sessions: [
+          {
+            id: sessionID,
+            slug: "prompt-long-model-mobile",
+            projectID,
+            directory,
+            title: "Long model mobile composer",
+            version: "dev",
+            model: { providerID: "openai", modelID: "long-model" },
+            time: { created: 1_700_000_000_000, updated: 1_700_000_000_000 },
+          },
+        ],
+        pageMessages: () => ({ items: [] }),
+      })
+      await page.addInitScript(() => {
+        localStorage.setItem(
+          "settings.v3",
+          JSON.stringify({ general: { newLayoutDesigns: true, shouldDisplayTabsToast: false } }),
