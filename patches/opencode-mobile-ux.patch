+/* Phone settings use a menu followed by one full-width panel. Desktop keeps tabs. */
+.settings-mobile-header { display: none; }
+[data-component="dialog-v2"] [data-slot="dialog-container"].provider-connect-container {
+  width: min(calc(100vw - 16px), 640px);
+  height: min(calc(100vh - 16px), 512px);
+}
+
+@media (max-width: 767px) {
+  .settings-v2 [data-slot="tabs-v2-trigger-wrapper"][data-value="shortcuts"] { display: none; }
+  [data-component="dialog-v2"] [data-slot="dialog-container"].provider-connect-container {
+    width: 100%;
+    height: 100dvh;
+    max-height: 100%;
+    border-radius: 0;
+    background: var(--v2-background-bg-base);
+  }
+  [data-component="dialog-v2"] .provider-connect-dialog [data-slot="dialog-header"] {
+    min-height: 64px;
+    padding: 8px 16px !important;
+    align-items: center;
+    border-bottom: 1px solid var(--v2-border-border-base);
+  }
+  [data-component="dialog-v2"] .provider-connect-dialog [data-slot="dialog-header-title"] {
+    font-size: 20px !important;
+    line-height: 28px;
+    padding-inline: 8px;
+  }
+  [data-component="dialog-v2"] .provider-connect-dialog [data-slot="dialog-close-button"] {
+    width: 48px;
+    height: 48px;
+    margin: 0 0 0 auto;
+  }
+  .provider-connect-dialog :is(input, textarea, button) { min-height: 48px; font-size: 16px; }
+  .provider-connect-dialog [data-slot="input-label"] { font-size: 15px; line-height: 24px; }
+  .provider-connect-dialog [data-component="input"] { min-width: 0; }
+  .provider-connect-dialog [data-slot="input-input"] { min-height: 48px; font-size: 16px; }
+  .provider-connect-dialog :is([data-slot="input-description"], [data-slot="input-error"]) {
+    font-size: 14px;
+    line-height: 22px;
+    overflow-wrap: anywhere;
+  }
+  .provider-connect-dialog form [data-row] { display: grid; grid-template-columns: minmax(0, 1fr) 48px; }
+  .provider-connect-dialog form [data-row] > div { grid-column: 1; min-width: 0; }
+  .provider-connect-dialog form [data-row] > button { grid-column: 2; grid-row: 1 / span 2; margin-top: 0; }
