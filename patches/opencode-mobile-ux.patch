+  .provider-connect-dialog [data-slot="input-label"] { font-size: 15px; line-height: 24px; }
+  .provider-connect-dialog [data-component="input"] { min-width: 0; }
+  .provider-connect-dialog [data-slot="input-input"] { min-height: 48px; font-size: 16px; }
+  .provider-connect-dialog :is([data-slot="input-description"], [data-slot="input-error"]) {
+    font-size: 14px;
+    line-height: 22px;
+    overflow-wrap: anywhere;
