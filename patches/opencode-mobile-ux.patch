+import type { Part } from "@opencode-ai/sdk/v2/client"
+import stripAnsi from "strip-ansi"
+
+export function turnOutput(parts: readonly Part[]) {
+  const part = parts.findLast((part) => part.type === "tool" && part.state.status === "running")
+  if (part?.type !== "tool" || part.state.status !== "running" || !["bash", "shell"].includes(part.tool)) return
+  const output = part.state.metadata?.output
+  if (typeof output !== "string") return
+  const line = stripAnsi(output.slice(-4096)).split(/[\r\n]/).findLast((line) => line.trim())?.trim()
+  if (!line) return
+  return line.length > 240 ? line.slice(0, 240) + "…" : line
+}
+
+export function turnStatus(parts: readonly Part[]) {
+  const running = parts.findLast((part) => part.type === "tool" && part.state.status === "running")
+  if (running?.type === "tool") {
+    if (["bash", "shell"].includes(running.tool)) return "ui.sessionTurn.status.runningCommands"
+    if (["edit", "write", "apply_patch"].includes(running.tool)) return "ui.sessionTurn.status.makingEdits"
+    if (["grep", "glob"].includes(running.tool)) return "ui.sessionTurn.status.searchingCodebase"
+    if (["webfetch", "websearch"].includes(running.tool)) return "ui.sessionTurn.status.searchingWeb"
+    if (running.tool === "task") return "ui.sessionTurn.status.delegating"
+    return "ui.sessionTurn.status.gatheringContext"
+  }
+  const last = parts.findLast((part) => ["tool", "text", "reasoning"].includes(part.type))
+  if (last?.type === "tool" && ["completed", "error"].includes(last.state.status)) {
+    return "ui.sessionTurn.status.consideringNextSteps"
+  }
+  return "ui.sessionTurn.status.thinking"
+}
