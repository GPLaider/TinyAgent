+        await expect(language).toBeVisible()
+        expect((await language.boundingBox())!.height).toBeGreaterThanOrEqual(48)
+        expect((await language.boundingBox())!.width).toBeGreaterThanOrEqual(width - 50)
+      }
+      await page.screenshot({ path: info.outputPath(`settings-${name.toLowerCase()}.png`) })
+      if (name === "Providers") {
+        const custom = dialog.locator(".settings-v2-provider-row").filter({ hasText: "Custom provider" })
+        await custom.getByRole("button", { name: "Connect", exact: true }).click()
