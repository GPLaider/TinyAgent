+  .provider-connect-dialog .custom-provider-form { max-height: none; min-height: 0; flex: 1; }
+  .provider-connect-dialog [data-slot="dialog-body"] { padding: 16px 8px; }
+  [data-component="dialog-v2"][data-variant="settings"] [data-slot="dialog-container"] {
+    width: 100%;
+    height: 100dvh;
+    max-height: 100%;
+    border-radius: 0;
+  }
+  .settings-mobile-header {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    flex: none;
+    width: 100%;
+    min-height: 64px;
+    padding: 8px 16px;
+    border-bottom: 1px solid var(--v2-border-border-base);
+  }
+  .settings-mobile-header h1 { padding-inline: 8px; font-size: 24px; font-weight: 640; }
+  .settings-mobile-header button {
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    gap: 8px;
+    min-width: 48px;
+    min-height: 48px;
+    font-size: 16px;
+  }
+  .settings-v2[data-component="tabs-v2"][data-variant="settings"][data-orientation="vertical"] {
+    height: auto;
+    min-height: 0;
+    flex: 1;
+  }
+  .settings-v2[data-component="tabs-v2"][data-variant="settings"][data-orientation="vertical"] [data-slot="tabs-v2-list"] {
+    width: 100%;
+    min-width: 0;
+    padding: 16px 24px;
+    background: var(--v2-background-bg-base);
+    overflow-y: auto;
+  }
+  .settings-v2[data-mobile-detail="true"] [data-slot="tabs-v2-list"],
+  .settings-v2[data-mobile-detail="false"] .settings-v2-panel { display: none !important; }
+  .settings-v2 [data-slot="tabs-v2-section-title"] { display: none; }
