+import { expect, test } from "bun:test"
+import { TimelineRow as Row } from "./timeline-row"
+
+test("row equality preserves every display field and user boundary", () => {
+  const pairs: [Row.TimelineRow, Row.TimelineRow][] = [
+    [new Row.UserMessage({ userMessageID: "u", anchor: true }), new Row.UserMessage({ userMessageID: "u", anchor: false })],
+    [new Row.Thinking({ userMessageID: "u" }), new Row.Thinking({ userMessageID: "u", reasoningHeading: "Next" })],
+    [new Row.Error({ userMessageID: "u", text: "a" }), new Row.Error({ userMessageID: "u", text: "b" })],
+    [new Row.TurnDivider({ userMessageID: "u", label: "compaction" }), new Row.TurnDivider({ userMessageID: "u", label: "interrupted" })],
+    [new Row.Retry({ userMessageID: "u" }), new Row.Retry({ userMessageID: "v" })],
+    [new Row.TurnGap({ userMessageID: "u" }), new Row.CommentStrip({ userMessageID: "u" })],
+  ]
+  for (const [a, b] of pairs) {
+    expect(Row.equals(a, a)).toBe(true)
+    expect(Row.equals(a, b)).toBe(false)
+    expect(Row.equals(b, a)).toBe(false)
+  }
+})
+
+test("assistant equality compares ordered references and previous-part flag", () => {
+  const part = (messageID = "m", partID = "p", previousAssistantPart = false) => new Row.AssistantPart({
+    userMessageID: "u", previousAssistantPart,
+    group: { key: "k", type: "part", ref: { messageID, partID } },
+  })
+  expect(Row.equals(part(), part())).toBe(true)
+  expect(Row.equals(part(), part("other"))).toBe(false)
+  expect(Row.equals(part(), part("m", "other"))).toBe(false)
+  expect(Row.equals(part(), part("m", "p", true))).toBe(false)
+})
