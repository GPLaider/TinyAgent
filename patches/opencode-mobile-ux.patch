+import { expect, test } from "bun:test"
+import type { Part } from "@opencode-ai/sdk/v2/client"
+import { turnStatus, turnOutput } from "./session-turn-status"
+
+test("busy turn exposes only actual latest shell output, without inventing download status", () => {
+  const tool = (status: "running" | "completed", output: unknown) =>
+    ({ id: "part", sessionID: "session", messageID: "message", callID: "call", type: "tool", tool: "bash",
+      state: { status, input: {}, time: { start: 1, end: 2 }, title: "fetch", output: "", metadata: { output } } }) as Part
+  expect(turnOutput([tool("running", "fetching\n\u001b[33mretry 2\u001b[0m\r\n")])).toBe("retry 2")
+  expect(turnOutput([tool("completed", "old error"), tool("running", "")])).toBeUndefined()
+  expect(turnOutput([tool("completed", "done")])).toBeUndefined()
+  expect(turnOutput([tool("running", { invalid: true })])).toBeUndefined()
+  expect(turnOutput([tool("running", "x".repeat(400))])?.length).toBe(241)
+})
+
+test("activity follows tool transitions instead of labeling every busy turn as thinking", () => {
+  const tool = (name: string, status: "pending" | "running" | "completed" | "error") =>
+    ({ type: "tool", tool: name, state: { status } }) as Part
+  expect(turnStatus([])).toBe("ui.sessionTurn.status.thinking")
+  expect(turnStatus([tool("bash", "pending")])).toBe("ui.sessionTurn.status.thinking")
+  expect(turnStatus([tool("bash", "running")])).toBe("ui.sessionTurn.status.runningCommands")
+  expect(turnStatus([tool("bash", "completed")])).toBe("ui.sessionTurn.status.consideringNextSteps")
+  expect(turnStatus([tool("bash", "error")])).toBe("ui.sessionTurn.status.consideringNextSteps")
+  expect(turnStatus([tool("bash", "completed"), tool("edit", "running")])).toBe("ui.sessionTurn.status.makingEdits")
+  expect(turnStatus([tool("bash", "running"), tool("read", "completed")])).toBe("ui.sessionTurn.status.runningCommands")
+  expect(turnStatus([tool("grep", "running")])).toBe("ui.sessionTurn.status.searchingCodebase")
+  expect(turnStatus([tool("bash", "completed"), { type: "reasoning", text: "next" } as Part])).toBe("ui.sessionTurn.status.thinking")
+})
