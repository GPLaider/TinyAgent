diff --git a/packages/app/e2e/regression/mobile-settings.spec.ts b/packages/app/e2e/regression/mobile-settings.spec.ts
new file mode 100644
index 0000000..e142604
--- /dev/null
+++ b/packages/app/e2e/regression/mobile-settings.spec.ts
@@ -0,0 +1,56 @@
+import { expect, test } from "@playwright/test"
+import { installTimelineSettings, mockStressTimeline } from "../performance/timeline/timeline-test-helpers"
+
+for (const width of [320, 390]) {
+  test(`settings use one readable panel at ${width}px`, async ({ page }, info) => {
+    await page.setViewportSize({ width, height: 844 })
+    await page.emulateMedia({ colorScheme: "light" })
+    await mockStressTimeline(page)
+    await installTimelineSettings(page)
+    await page.goto("/")
+    await page.keyboard.press("Control+,")
+    const dialog = page.locator(".settings-v2-dialog")
+    await expect(dialog.getByRole("heading", { name: "Settings", exact: true })).toBeVisible()
+    const general = dialog.getByRole("tab", { name: /^General/ })
+    await expect(general).toBeVisible()
+    await expect(dialog.getByRole("tab", { name: /^Shortcuts/ })).toBeHidden()
+    expect((await general.boundingBox())!.height).toBeGreaterThanOrEqual(48)
+    await page.screenshot({ path: info.outputPath("settings-menu.png") })
+    for (const name of ["General", "Providers", "Models", "Servers"]) {
+      await dialog.getByRole("tab", { name: new RegExp(`^${name}`) }).click()
+      await expect(dialog.getByRole("tablist")).toBeHidden()
+      const panel = dialog.locator('[data-slot="tabs-v2-content"]:visible')
+      await expect(panel).toHaveCount(1)
+      expect((await panel.boundingBox())!.width).toBeGreaterThanOrEqual(width - 2)
+      expect(await panel.evaluate((el) => el.scrollWidth <= el.clientWidth + 1)).toBe(true)
+      if (name === "General") {
+        const language = panel.getByRole("button", { name: "English", exact: true })
+        await expect(language).toBeVisible()
+        expect((await language.boundingBox())!.height).toBeGreaterThanOrEqual(48)
+        expect((await language.boundingBox())!.width).toBeGreaterThanOrEqual(width - 50)
+      }
+      await page.screenshot({ path: info.outputPath(`settings-${name.toLowerCase()}.png`) })
+      if (name === "Providers") {
+        const custom = dialog.locator(".settings-v2-provider-row").filter({ hasText: "Custom provider" })
+        await custom.getByRole("button", { name: "Connect", exact: true }).click()
+        const form = page.locator(".provider-connect-dialog")
+        const endpoint = form.getByRole("textbox", { name: "Base URL", exact: true })
+        await expect(endpoint).toBeVisible()
+        expect((await form.boundingBox())!.width).toBe(width)
+        expect((await form.boundingBox())!.height).toBe(844)
+        expect((await endpoint.boundingBox())!.height).toBeGreaterThanOrEqual(48)
+        await endpoint.fill("https://example.invalid/v1")
+        await expect(endpoint).toHaveValue("https://example.invalid/v1")
+        await expect(page.getByText("Something went wrong", { exact: true })).toHaveCount(0)
+        expect(await form.evaluate((el) => el.scrollWidth <= el.clientWidth + 1)).toBe(true)
+        await page.screenshot({ path: info.outputPath("settings-custom-provider.png") })
+        await form.getByRole("button", { name: "Navigate back", exact: true }).click()
+        await expect(dialog.getByRole("heading", { name: "Providers", exact: true })).toBeVisible()
+      }
+      await dialog.getByRole("button", { name: "Settings", exact: true }).click()
+      await expect(general).toBeVisible()
+    }
+    await dialog.getByRole("button", { name: "Close", exact: true }).click()
+    await expect(dialog).toHaveCount(0)
+  })
+}
