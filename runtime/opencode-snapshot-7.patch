+import { expect } from "bun:test"
+import { Effect } from "effect"
+import { LayerNode } from "@opencode-ai/core/effect/layer-node"
+import { SessionProjector } from "@opencode-ai/core/session/projector"
+import { Session } from "@/session/session"
+import { SessionSummary } from "@/session/summary"
+import { MessageID } from "@/session/schema"
+import { testEffect } from "../lib/effect"
+import { ProviderV2 } from "@opencode-ai/core/provider"
+import { ModelV2 } from "@opencode-ai/core/model"
+
+const it = testEffect(LayerNode.compile(LayerNode.group([Session.node, SessionSummary.node, SessionProjector.node])))
+
+it.instance("one message diff does not hydrate the entire conversation", () => Effect.gen(function* () {
+  const sessions = yield* Session.Service
+  const summary = yield* SessionSummary.Service
+  const session = yield* sessions.create({})
+  const other = yield* sessions.create({})
+  const messageID = MessageID.ascending()
+  const diff = { file: "hello.txt", before: "", after: "hello", additions: 1, deletions: 0 }
+  yield* sessions.updateMessage({
+    id: messageID, sessionID: session.id, role: "user", time: { created: Date.now() },
+    agent: "build", model: { providerID: ProviderV2.ID.make("test"), modelID: ModelV2.ID.make("test") }, summary: { diffs: [diff] },
+  })
+  const messages = sessions.messages
+  Object.assign(sessions, { messages: () => Effect.die("Whole-conversation hydration is forbidden for one diff") })
+  yield* Effect.gen(function* () {
+    expect(yield* summary.diff({ sessionID: session.id, messageID })).toEqual([diff])
+    expect(yield* summary.diff({ sessionID: other.id, messageID })).toEqual([])
+    expect(yield* summary.diff({ sessionID: session.id, messageID: MessageID.ascending() })).toEqual([])
+    expect(yield* summary.diff({ sessionID: session.id })).toEqual([])
+  }).pipe(Effect.ensuring(Effect.sync(() => Object.assign(sessions, { messages }))))
+  yield* sessions.remove(session.id)
+  yield* sessions.remove(other.id)
+}))
