+import { expect, test } from "bun:test"
+import { Effect, Layer } from "effect"
+import { LayerNode } from "@opencode-ai/core/effect/layer-node"
+import { SessionStatus } from "../../src/session/status"
+import { SessionID } from "../../src/session/schema"
+import { InstanceRef } from "../../src/effect/instance-ref"
+import { disposeInstance } from "../../src/effect/instance-registry"
+import { EventV2Bridge } from "../../src/event-v2-bridge"
+import type { InstanceContext } from "../../src/project/instance-context"
+
+test("server status covers both directories and removes idle/disposed work", async () => {
+  const first = SessionID.make("ses_notificationFirst")
+  const second = SessionID.make("ses_notificationSecond")
+  const inDirectory = <A, E, R>(directory: string, effect: Effect.Effect<A, E, R>) =>
+    effect.pipe(Effect.provideService(InstanceRef, { directory } as InstanceContext))
+  await Effect.runPromise(Effect.gen(function* () {
+    const status = yield* SessionStatus.Service
+    yield* inDirectory("/notification-one", status.set(first, { type: "busy" }))
+    yield* inDirectory("/notification-two", status.set(second, { type: "busy" }))
+    expect([...(yield* inDirectory("/notification-one", status.list())).keys()]).toEqual([first])
+    expect([...(yield* status.listAll()).keys()].sort()).toEqual([first, second].sort())
+    yield* inDirectory("/notification-one", status.set(first, { type: "idle" }))
+    expect([...(yield* status.listAll()).keys()]).toEqual([second])
+    yield* Effect.promise(() => disposeInstance("/notification-two"))
+    expect((yield* status.listAll()).size).toBe(0)
+  }).pipe(
+    Effect.provide(LayerNode.compile(SessionStatus.node, [
+      [EventV2Bridge.node, Layer.succeed(EventV2Bridge.Service, { publish: () => Effect.void } as any)],
+    ])),
+  ))
+})
