@@ -0,0 +1,71 @@
+import { afterEach, expect } from "bun:test"
+import { Context, Deferred, Effect, Fiber, Layer } from "effect"
+import { AppProcess } from "@opencode-ai/core/process"
+import { LayerNode } from "@opencode-ai/core/effect/layer-node"
+import { FSUtil } from "@opencode-ai/core/fs-util"
+import { Snapshot } from "../../src/snapshot"
+import { disposeAllInstances, TestInstance, testInstanceStoreLayer } from "../fixture/fixture"
+import { testEffect } from "../lib/effect"
+
+class Gate extends Context.Service<Gate, {
+  entered: Deferred.Deferred<void>
+  release: Deferred.Deferred<void>
+  collected: Deferred.Deferred<void>
+}>()("SnapshotDiffGate") {}
+
+const gate = Layer.effect(Gate, Effect.gen(function* () {
+  return { entered: yield* Deferred.make<void>(), release: yield* Deferred.make<void>(), collected: yield* Deferred.make<void>() }
+}))
+const process = Layer.effect(AppProcess.Service, Effect.gen(function* () {
+  const original = yield* AppProcess.Service
+  const wait = yield* Gate
+  return AppProcess.Service.of({
+    ...original,
+    run: (command, options) => Effect.gen(function* () {
+      if (command._tag === "StandardCommand" && command.args.includes("cat-file")) {
+        yield* Deferred.succeed(wait.entered, undefined)
+        yield* Deferred.await(wait.release)
+      }
+      if (command._tag === "StandardCommand" && command.args.includes("gc")) {
+        expect(yield* Deferred.isDone(wait.release)).toBe(true)
+        yield* Deferred.succeed(wait.collected, undefined)
+      }
+      return yield* original.run(command, options)
+    }),
+  })
+})).pipe(Layer.provide(Layer.mergeAll(LayerNode.compile(AppProcess.node), gate)))
+const it = testEffect(Layer.mergeAll(
+  LayerNode.compile(LayerNode.group([Snapshot.node, FSUtil.node]), [[AppProcess.node, process]]),
+  testInstanceStoreLayer,
+  gate,
+))
+afterEach(disposeAllInstances)
+
+it.instance("slow immutable diff does not block a new snapshot", () => Effect.gen(function* () {
+  const tmp = yield* TestInstance
+  const fs = yield* FSUtil.Service
+  const snapshot = yield* Snapshot.Service
+  const wait = yield* Gate
+  yield* fs.writeWithDirs(`${tmp.directory}/file.txt`, "before\n")
+  const before = yield* snapshot.track()
+  yield* fs.writeWithDirs(`${tmp.directory}/file.txt`, "after\n")
+  const after = yield* snapshot.track()
+  expect(before).toBeTruthy()
+  expect(after).toBeTruthy()
+  const diff = yield* snapshot.diffFull(before!, after!).pipe(Effect.forkChild)
+  yield* Deferred.await(wait.entered).pipe(Effect.timeout("10 seconds"),
+    Effect.catchTag("TimeoutError", () => Effect.die("diff reader never entered")))
+  const cleanup = yield* snapshot.cleanup().pipe(Effect.forkChild)
+  yield* fs.writeWithDirs(`${tmp.directory}/next.txt`, "next tool\n")
+  const tracked = yield* snapshot.track().pipe(
+    Effect.timeout("2 seconds"),
+    Effect.catchTag("TimeoutError", () => Effect.die("snapshot writer blocked behind diff reader")),
+    Effect.ensuring(Deferred.succeed(wait.release, undefined)),
+  )
+  expect(tracked).toBeTruthy()
+  const result = yield* Fiber.join(diff)
+  expect(result.map(item => item.file)).toEqual(["file.txt"])
+  expect(result[0].patch).toContain("+after")
+  yield* Fiber.join(cleanup)
+  expect(yield* Deferred.isDone(wait.collected)).toBe(true)
+}), { git: true }, 20000)
