diff --git a/packages/opencode/src/session/startup-recovery.ts b/packages/opencode/src/session/startup-recovery.ts
new file mode 100644
index 0000000..3cf01dd
--- /dev/null
+++ b/packages/opencode/src/session/startup-recovery.ts
@@ -0,0 +1,35 @@
+import { Effect } from "effect"
+import { sql } from "drizzle-orm"
+import { Database } from "@opencode-ai/core/database/database"
+
+// Called only before serve listens, after TinyAgent has stopped the previous
+// owned process tree. Never invoke against a live shared database.
+export const recoverInterruptedBeforeServe = Effect.gen(function* () {
+  const { db } = yield* Database.Service
+  const now = Date.now()
+  // No HTTP clients exist yet. One transaction keeps messages and tools consistent.
+  yield* db.transaction((tx) => Effect.gen(function* () {
+    yield* tx.run(sql`UPDATE message SET
+      data = json_set(data, '$.time.completed', ${now}, '$.error',
+        json(COALESCE(json_extract(data, '$.error'),
+          json_object('name', 'MessageAbortedError', 'data',
+            json_object('message', 'Previous runtime stopped before completion'))))),
+      time_updated = ${now}
+      WHERE json_extract(data, '$.role') = 'assistant'
+        AND json_extract(data, '$.time.completed') IS NULL
+        AND (json_extract(data, '$.finish') IS NULL OR id IN (
+          SELECT message_id FROM part WHERE json_extract(data, '$.type') = 'tool'
+            AND json_extract(data, '$.state.status') IN ('pending', 'running')))`)
+    yield* tx.run(sql`UPDATE part SET
+      data = json_set(data,
+        '$.state.status', 'error',
+        '$.state.error', 'Previous runtime stopped before completion',
+        '$.state.metadata', json_set(COALESCE(json_extract(data, '$.state.metadata'), '{}'),
+          '$.interrupted', json('true'), '$.recovery', 'runtime-restarted'),
+        '$.state.time.start', COALESCE(json_extract(data, '$.state.time.start'), ${now}),
+        '$.state.time.end', ${now}),
+      time_updated = ${now}
+      WHERE json_extract(data, '$.type') = 'tool'
+        AND json_extract(data, '$.state.status') IN ('pending', 'running')`)
+  })).pipe(Effect.orDie)
+})
